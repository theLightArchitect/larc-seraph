<plist version="1.0">
<!-- larc-seraph synthetic fixture. classification: synthetic-benign. inert. do not load with launchctl. -->
<dict>
  <key>Label</key>
  <string>com.example.larc.synthetic</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
